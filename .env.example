# Open Meetup 局域网模式建议配置

# 主持人口令（至少 6 位；生产环境必填；正式活动请勿使用默认弱口令）
HOST_PASSWORD=change-me-please

# 访问端口（npm start 生产模式下即服务端单端口）
LAN_PORT=8080

# 可选：后端端口（仅 --dev 开发者模式需要）
# PORT=3001

# 可选：断线与清理策略
# DISCONNECT_GRACE_MS=300000
# ROOM_CLEANUP_INTERVAL_MS=30000
# SOCKET_PING_INTERVAL_MS=10000
# SOCKET_PING_TIMEOUT_MS=10000

# 可选：限流（线下场景所有参与者共享出口 IP，校验类限流已按 NAT 规模放宽）
# TICKET_CHECK_RATE_LIMIT_MAX_REQUESTS=300
# IMAGE_UPLOAD_RATE_LIMIT_MAX_REQUESTS=30
# SOCKET_EVENT_RATE_LIMIT_MAX=180
# CREATE_PASSWORD_MAX_FAILURES=10
# CREATE_PASSWORD_LOCKOUT_MS=300000

# 可选：内容与资产上限
# IMAGE_UPLOAD_MAX_BYTES=4000000
# MAX_PAGE_CONTENT_CANVAS_BYTES=8000000
# MAX_PAGE_CONTENT_TEXT_BYTES=64000
# MAX_ROOM_ASSETS_BYTES=268435456
# SOCKET_MAX_HTTP_BUFFER_SIZE=10000000

# 可选：安全开关（默认关闭；确认理解风险后再打开）
# ALLOW_SVG_UPLOAD=0

# 可选：公网反代部署时必须显式配置（单端口自托管模式可留空）
# CORS_ALLOW_ORIGIN=http://192.168.0.10:8080
# TRUST_PROXY=false
